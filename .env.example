# Configuración de Supabase
# Obtén estos valores en tu panel de Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Número de WhatsApp para recibir pedidos (código de país + número, sin espacios ni el signo +)
# Ejemplo para Bolivia: 59170012345 | México: 5215512345678 | España: 34600000000
VITE_WHATSAPP_PHONE=59170000000

# Nombre de la tienda
VITE_STORE_NAME="Luna Clara"
